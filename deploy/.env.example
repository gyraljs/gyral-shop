# Copy to deploy/.env on the server (chmod 600) and fill in the two secrets.
# The image digest printed when the image was pushed (docs/references/deploying.md).
GYRAL_SHOP_IMAGE=docker-push.xode.app/gyraljs/gyral-shop@sha256:REPLACE_WITH_PUSHED_IMAGE_DIGEST
# Must match the SITE_ORIGIN the image was built with (prerendered pages carry it).
SITE_ORIGIN=https://demo-shop.gyral.dev
# openssl rand -hex 32
APP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# The seeded admin's password (admin@shop.test). 12+ characters, never the public default.
# Re-applied at every nightly reset. openssl rand -base64 18
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
# The nightly demo reset, local time in STORE_TIME_ZONE.
DEMO_RESET_AT=03:00
STORE_TIME_ZONE=America/New_York
# These must match the names already configured in your Traefik deployment.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
